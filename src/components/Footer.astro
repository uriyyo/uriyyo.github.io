---
import { SITE_TITLE, SOCIAL_LINKS } from '../consts';
const today = new Date();
---

<footer class="border-t-2 border-line bg-ink text-canvas dark:bg-panel dark:text-ink">
	<div class="mx-auto flex max-w-4xl flex-col items-center justify-between gap-3 px-4 py-5 font-mono text-xs font-bold uppercase sm:flex-row sm:px-6">
		<span>&copy; {today.getFullYear()} {SITE_TITLE}</span>
		<div class="flex flex-wrap justify-center gap-x-4 gap-y-2">
			{SOCIAL_LINKS.map((link) => (
				<a href={link.href} target="_blank" rel="noopener noreferrer" class="hover:bg-highlight hover:text-highlight-ink">
					{link.name}
				</a>
			))}
			<a href="/rss.xml" class="hover:bg-highlight hover:text-highlight-ink">RSS</a>
		</div>
	</div>
</footer>
