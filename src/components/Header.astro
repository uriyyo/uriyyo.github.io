---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="border-b-2 border-line bg-panel">
	<nav class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6">
		<a href="/" class="inline-flex items-center gap-2.5 font-sans text-lg font-extrabold uppercase tracking-wide">
			<span class="mark-tile" aria-hidden="true">u</span> {SITE_TITLE}
		</a>
		<div class="flex items-center">
			<div class="flex">
				<HeaderLink href="/">home</HeaderLink>
				<HeaderLink href="/blog">blog</HeaderLink>
				<HeaderLink href="/about">about</HeaderLink>
			</div>
			<button
				id="theme-toggle"
				type="button"
				aria-label="Toggle dark mode"
				class="ml-3 border-2 border-line bg-panel p-1.5 text-ink hover:bg-highlight hover:text-highlight-ink"
			>
				<svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
				</svg>
				<svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
					<circle cx="12" cy="12" r="4" />
					<path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41" />
				</svg>
			</button>
		</div>
	</nav>
</header>
<script>
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const dark = document.documentElement.classList.toggle('dark');
		localStorage.setItem('theme', dark ? 'dark' : 'light');
	});
</script>
